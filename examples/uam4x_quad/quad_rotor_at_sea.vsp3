      <CustomGeom>
        <Width Value="1.500000000000000000e+00" ID="KJVWJBYIPIG"/>
        <SeatHeight Value="2.999999999999999889e-01" ID="FEKVEWBQCRB"/>
        <SeatLength Value="1.500000000000000000e+00" ID="HUEHUZQXNIR"/>
        <BackHeight Value="3.000000000000000000e+00" ID="XNVOPNOSRBZ"/>
