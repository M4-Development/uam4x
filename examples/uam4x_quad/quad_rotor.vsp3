      <CustomGeom>
        <Width Value="1.500000000000000000e+00" ID="XCRBORCGOYY"/>
        <SeatHeight Value="2.999999999999999889e-01" ID="UAXYSYJUUUQ"/>
        <SeatLength Value="1.500000000000000000e+00" ID="ENDVYAQFOTU"/>
