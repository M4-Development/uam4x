config='multicopter',nrotor=4,rotate=1,-1,-1,1,ang_multicopter=45.,-45.,135.,-135.,
&END

&DEFN quant='Cases', &END
&VALUE
	title = 'UAM-N-quad-5-turbo-xshaft-coll-flap-550fps',
	subtitle1 = 'Near term technology (Generation N), Quadrotor, 5 occupant',
	subtitle2 = 'Turboshaft, cross-shafted with gearboxes',
	subtitle3 = 'Collective-controlled, flapping rotor, 500 ft/s tip speed',
	TASK_Size = 1,
	TASK_Mission = 0,
	TASK_Perf = 0,
	TASK_Map_engine = 0,
	TASK_Map_aero = 0,
	WRITE_input = 2,
	WRITE_flight = 1,
	OUT_design = 1,
	FILE_design = 'Output/UAM-N-quad-5-turbo-xshaft-coll-flap-550.design',
	OUT_perf = 1,
	FILE_perf = 'Output/UAM-N-quad-5-turbo-xshaft-coll-flap-550.perf',
	OUT_geometry = 0,
	FILE_geometry = 'Output/Geometry.geom',
	OUT_aircraft = 1,
	FILE_aircraft = 'Output/UAM-N-quad-5-turbo-xshaft-coll-flap-550.acd',
	OUT_solution = 1,
	FILE_solution = 'Output/UAM-N-quad-5-turbo-xshaft-coll-flap-550.soln',
	OUT_sketch = 0,
	FILE_sketch = 'Output/Sketch.dxf',
	FILE_engine = 'Output/Engine.eng',
	FILE_aero = 'Output/Aero.aero',
OUT_error = 0,
	FILE_error = 'Output/Error.err',
	Units = 1,
&END

 !@ # NASA Urban Air Mobility Quadrotor Reference Vehicle, as updated in the year 2023
 !@ For more information, see:
 !@ Silva et al., "Updated  Urban Air Mobility Reference Vehicles for Technology Development Incorporating Recent Technology, Policy, and Economic Developments," NASA/TP-2023-XXXXXX
 !@ This AIDEN project is intended to be distributed publicly, for the following objectives:
 !@ 1. To document the reference vehicle inputs and outputs used in sizing
 !@ 2. To document excursions and variants of the reference vehicle. 
 !@ 3. To serve as an example of an AIDEN project which exercises many of the available features in AIDEN
 !@
 !@ The vehicle inputs and outputs are in U.S. customary units: length = feet, force = pound-force. See NDARC manuals.
 !@
 !@ ## Project contents
 !@ 1. NDARC inputs for quadrotor sizing
 !@     * Baseline aircraft is 5 occupant, turboshaft, cross-shafted, collective-controlled, flapping rotor, 550 ft/s tip speed 
 !@         - Design mission 1 sizes DGW, installed power, xmsn, fuel tank for 2-hop UAM mission with 5 occupants
 !@         - Design condition 1 sizes WMTO for the lifting capability at maximum power at 6,000 ft/ISA hover out of ground effect (HOGE)
 !@         - Design Condition 2 sizes engine for 500 ft/min cruise climb capability at 10,000 ft/ISA to ensure adequate margin at high altitude for maneuver
 !@         - Excursions: vary design rotor tip speed: 375 ft/s, 400 ft/s, 450 ft/s 500 ft/s, 600 ft/s, 650 ft/s, 700 ft/s
 !@         - Variant: battery powered, gearbox, cross-shafted, collective-controlled, flapping, 550 ft/s
 !@             + Excursion: Advanced technology, battery powered, direct-drive, cross-shafted, collective-controlled flapping, 550 ft/s
 !@             + Excursion: battery powered, direct-drive, cross-shafted, collective-controlled flapping, 550 ft/s
 !@         - Variant: battery powered not cross-shafted, gearbox, collective controlled, flapping, 550 ft/s
 !@             + Excursion: battery powered not cross-shafted, direct-drive, collective-controlled, flapping, 550 ft/s
 !@             + Excursion: battery powered not cross-shafted, direct-drive, rpm-controlled, flapping, 550 ft/s hover
 !@             + Excursion: battery powered not cross-shafted, direct-drive, rpm-controlled, stiff rotor, 550 ft/s hover
 !@         - Variant: turboelectric (electric parallel) powered cross-shafted, gearbox, collective controlled, flapping, 550 ft/s
 !@             + Excursion: turboelectric (electric parallel) powered not cross-shafted, direct-drive, collective-controlled, flapping, 550 ft/s
 !@     * Use of linked copies and reference copies to build variants and excursions
 !@     * Use of Aircraft Supercomponents to build and examine the aircraft before loading into jobs
 !@         - Propulsion system topology easier to understand, such as the single propulsion for cross shafted, and the separate electrical systems for not cross-shafted electric
 !@         - Trim settings easier to understand, such as difference between collective control (rotor T matrix populated) versus rpm control (propulsion T matrix populated)
 !@     * OpenVSP update via Python Script Event "ALPINE3_gen" using a template quad-5-turbo-xshaft.vsp3 in the folder [AIDEN Workspace]/UAM-quad-update_2023/resources
 !@ 2. NDARC inputs for off-design runs of sized aircraft
 !@     * Noise certification for Federal Aviation Regulations Part 36H
 !@     * Speed sweeps for power: Weight Empty, Design Gross Weight, Maximum Takeoff Weight
 !@     * Best effort speeds vs altitude at DGW: VBE, VLRC, VMCP
 !@ 
 !@ The following is an example of how to include a graphic in the report. In this case, the graphic is in the resources folder, 
 !@ but was not drag-and-dropped into AIDEN, so AIDEN does not have an entty in the project tree view. The graphic is presented at 1/2 size.
 !@ 
 !@ <img src="./resources/UAM-N-5-quad-turbo-xshaft-coll-flap-550_4view.png" width="1377" height="925">
 !@ 
 !@ Graphics may be generated automatically by some event (such as a plotter event) and linked in the same way: TODO
 !@ 
  
&DEFN action='ident', title='Sizing-solution',
	created='09:22:00 18-Jul-2024', &END

&DEFN quant='Solution', &END
&VALUE
     trace_case=2,
     trace_size=2,
     relax_trim=.5,	deriv_trim=2,	toler_trim=.0002,	niter_trim = 60,
     maxinc_fly = 0.1,
     maxinc_tank = 0.2,
     niter_param=10,
     relax_xmsn = 0.2,
trace_size = 2
&END

&DEFN action='ident', title='quad-turbo-xshaft',
	created='09:22:00 18-Jul-2024', &END

&DEFN quant='Aircraft', &END
&VALUE title='Quad-5-turbo-xshaft',
     DGW=4000.,	SDGW=4000.,	WMTO=4000.,	nz_ult=4.0,	dSDGW=0.,	fSDGW=1.,
     altitude=6000.,	SET_atmos='std',                   ! 6k/ISA
     FIX_drag=0,	FIX_DL=0,                              ! FIX_drag=1 DoQ, 2 CD, 3 kDrag; FIX_DL=1 DoQV, 2 kDL
     INPUT_geom=2,	KIND_scale=1,	kScale=1,               ! scaled geometry (x/R,y/R,z/R)
        KIND_Ref=3,                                    ! fuselage reference
     !
     ncontrol=4,	IDENT_control='coll','latcyc','lngcyc','pedal',
     nRotor=4,	nTail=0, 
    !TODO: Update after performing massprop in OpenVSP:
    !kx=##, ky=##, kz=##,     
&END

&DEFN action='ident', title='5-occupant-systems',
	created='09:22:00 18-Jul-2024', &END

&DEFN quant='Systems', &END
&VALUE
     title='Quadcopter Systems 5 occupant',
     SET_Wpayload=2,	Upass=200.,        ! Payload is 200 lb/occupant, inclusive of baggage
     SET_Wcrew=1,	Wcrew=0.,             ! Assume that onboard pilot weighs same as any passenger which they displace
     Wtrap=10.,                        ! Some small amount of trapped fluids in gearboxes and fuel lines. 10 lb for turboshaft and 5 gearbox cross-shafted, less for all-electric
     SET_Wvib=1,	Wvib=0.,	fWvib=0.03,    ! Flapping blade
     SET_Wcont=1,	Wcont=0.,	fWcont=0.05, ! Component weights within data base
     Wfc_afcs=40.,                     ! Fly-by-wire computers (20 lb) and associated supplemental sensors for fault-tolerant control (5 lb per rotor) = 20 lb + nrotor * 5 lb/rotor
     fRWfc_nb=1.,	fRWhyd=0.,	KIND_WRWfc=1,	xRWfc_red=1., ! Collective control
     MODEL_FWfc=0,	MODEL_CVfc=0,        ! No fixed wing or conversion systems in a quadrotor
     Winstrument=10.,                  ! Airspeed probes, inertial measurement systems, global positioning systems
     WMEQ=40.,                         ! Electronics and sensors for sense and avoid, data/voice links
     Welectrical=60.0,                 ! In-flight entertainment, external lighting = 10 lb * Npass + 10 lb
     Wenviron=75.,                     ! Environmental control = Npass * 15 lb/occupant
     SET_Wfurnish=1,	Wfurnish=150.,     ! Seats at 25 lb, insulation, carpet, handles, etc. 5 lb = Npass * (25 lb/occupant + 5 lb/occupant)
     MODEL_DI=1,	kDeIce_elec=4*0.15,	kDeIce_rotor=4*0.15,	kDeIce_air=0.006,
     SET_fold=0,                       ! No folding on the ground for storage. Folding could potentially save nearly a diameter in width and length.
&END

