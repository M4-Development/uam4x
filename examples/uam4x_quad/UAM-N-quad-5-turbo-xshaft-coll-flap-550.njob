&DEFN action='ident', title='Generic-500hp-turboshaft',
	created='09:22:00 18-Jul-2024', &END

&DEFN quant='EngineModel', &END
&VALUE title = 'Turboshaft Engine Math Model Data (GEN500)',
      notes = 'Generic 500 hp Engine',
      ident = 'GEN500',
 ! Engine Ratings
      nrate = 4,
      rating = 'MCP  ', 'IRP  ', 'MRP  ', 'CRP  ',
 ! Weight
      Kwt0_eng =       0.000,
      Kwt1_eng =       0.340,
      Kwt2_eng =       0.000,
      Xwt_eng  =      0.0000,
 ! Reference
      P0_ref     =      500.,      600.,      635.,      665.,
      SP0_ref    =      116.,      136.,      143.,      149.,
      Pmech_ref  =      750.,      750.,      750.,      750.,
      sfc0C_ref  =     0.54,
      SF0C_ref   =      5.9,
      Nspec_ref  =   35600.,
      Nopt0C_ref =   35600.,
 ! Scaling, MF_ref=4.3
      MF_limit    =      9.,
      SP0C_limit  =    125.,
      sfc0C_limit =    0.48,
      KNspec      =  73910.,
 ! Optimum Power Turbine Speed (linear)
      MODEL_OptN = 1,
      KNoptA =     1.,
      KNoptB =     0.,
      XNeta  =     2.,
 ! Single Set of Input Parameters
      INPUT_param = 1,
 ! Power Available
      INPUT_lin = 1,
    ! specific power
      Nspa =  1,  1,  1,  1,
      Kspa0(1,1) =       3.80,   0.00,   0.00,   0.00,   0.00,  ! MCP  
      Kspa0(1,2) =       3.20,   0.00,   0.00,   0.00,   0.00,  ! IRP  
      Kspa0(1,3) =       3.00,   0.00,   0.00,   0.00,   0.00,  ! MRP  
      Kspa0(1,4) =       2.80,   0.00,   0.00,   0.00,   0.00,  ! CRP  
      Kspa1(1,1) =      -2.80,   0.00,   0.00,   0.00,   0.00,  ! MCP  
      Kspa1(1,2) =      -2.20,   0.00,   0.00,   0.00,   0.00,  ! IRP  
      Kspa1(1,3) =      -2.00,   0.00,   0.00,   0.00,   0.00,  ! MRP  
      Kspa1(1,4) =      -1.80,   0.00,   0.00,   0.00,   0.00,  ! CRP  
      Xspa0(1,1) =      -0.22,   0.00,   0.00,   0.00,   0.00,  ! MCP  
