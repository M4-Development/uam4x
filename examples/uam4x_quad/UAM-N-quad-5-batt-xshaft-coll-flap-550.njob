&DEFN action='ident', title='5-occupant-systems',
	created='07:01:00 29-Nov-2023', &END

&DEFN quant='Systems', &END
&VALUE
     title='Quadcopter Systems 5 occupant',
     SET_Wpayload=2,	Upass=200.,        ! Payload is 200 lb/occupant, inclusive of baggage
     SET_Wcrew=1,	Wcrew=0.,             ! Assume that onboard pilot weighs same as any passenger which they displace
     Wtrap=10.,                        ! Some small amount of trapped fluids in gearboxes and fuel lines. 10 lb for turboshaft and 5 gearbox cross-shafted, less for all-electric
     SET_Wvib=1,	Wvib=0.,	fWvib=0.03,    ! Flapping blade
     SET_Wcont=1,	Wcont=0.,	fWcont=0.05, ! Component weights within data base
     Wfc_afcs=40.,                     ! Fly-by-wire computers (20 lb) and associated supplemental sensors for fault-tolerant control (5 lb per rotor) = 20 lb + nrotor * 5 lb/rotor
     fRWfc_nb=1.,	fRWhyd=0.,	KIND_WRWfc=1,	xRWfc_red=1., ! Collective control
     MODEL_FWfc=0,	MODEL_CVfc=0,        ! No fixed wing or conversion systems in a quadrotor
     Winstrument=10.,                  ! Airspeed probes, inertial measurement systems, global positioning systems
     WMEQ=40.,                         ! Electronics and sensors for sense and avoid, data/voice links
     Welectrical=60.0,                 ! In-flight entertainment, external lighting = 10 lb * Npass + 10 lb
     Wenviron=75.,                     ! Environmental control = Npass * 15 lb/occupant
     SET_Wfurnish=1,	Wfurnish=150.,     ! Seats at 25 lb, insulation, carpet, handles, etc. 5 lb = Npass * (25 lb/occupant + 5 lb/occupant)
     MODEL_DI=1,	kDeIce_elec=4*0.15,	kDeIce_rotor=4*0.15,	kDeIce_air=0.006,
     SET_fold=0,                       ! No folding on the ground for storage. Folding could potentially save nearly a diameter in width and length.
&END

